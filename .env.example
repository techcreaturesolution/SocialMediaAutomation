# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/social-media-automation

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Stability AI (Image Generation)
STABILITY_API_KEY=your_stability_ai_key

# Replicate (Video Generation)
REPLICATE_API_TOKEN=your_replicate_token

# Google Cloud (Translation)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_key

# Facebook / Instagram (Meta Graph API)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Meta Business OAuth (connects Facebook Pages + Instagram Business)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:5000/api/meta/callback

# Twitter / X API v2
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# YouTube (Google API)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/auth/youtube/callback

# Redis (Bull Queue)
REDIS_URL=redis://localhost:6379

# AWS S3 (Media Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=social-media-automation-media

# Company Branding Defaults
COMPANY_NAME=Tech Creature Solution
COMPANY_WEBSITE=https://techcreaturesolution.com
COMPANY_EMAIL=techcreaturesolution@gmail.com
COMPANY_PHONE=+91-XXXXXXXXXX
